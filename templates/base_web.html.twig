<!DOCTYPE html>
<html lang="fr" {% block darkmode %}{% endblock %}{% if app.environment != 'prod' %} data-dev="true"{% endif %}>
	<head>
        {% set current_wp = webpage.currentItem|default(false) ? webpage.currentItem : webpage|default(null) %}
        {% block html_meta %}
		<meta charset="{{ app.service.getStringEncoder() }}">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
            {%- if not app.isProdHost() -%}[{{ app.isLocalHost() ? 'LOCAL' : 'NOT PROD'  }} SERVER] - {% endif -%}
            {%- block title -%}{{ current_wp.title|default(Identity.name|default('webpage'))|striptags }}{% endblock -%}
		</title>
        {% block favicon %}
        {% include '@AequationLabo/partials/_favicon.html.twig' %}
        {% endblock %}
        {% block metadescription %}
            {% if current_wp %}
			{% set md = current_wp.metadescription|default(current_wp.title)|striptags|trim %}
            {% if md|hasText %}
            <meta name="description" content="{% block metadescription_text %}{{ md }}{% endblock %}">
            {% endif %}
            {% endif %}
        {% endblock %}
        {% block stylesheets %}
        {% endblock %}
		{% block javascripts %}
			{% block importmap %}{{ importmap('app') }}{% endblock %}
		{% endblock %}
		{{ app.service.getTurboMetas() }}
        {% endblock %}
	</head>
	{% block body %}
	{# <body id="app" data-app="{{ app.service.appParams(true, 'public_app') }}" {{ stimulus_controller('globalapp') }}> #}
	<body class="wscss" id="app" {{ stimulus_controller('globalapp') }}>
        {% include '@AequationLabo/partials/_not_prod.html.twig' %}
        {% block option_nav_section %}
        <twig:OptionMenu :webpage="webpage|default(null)" />
        {% endblock %}
        {% block nav_section %}
        <twig:HeaderMenu :webpageOrMenu="webpage|default(null)" :options="true" />
        {% endblock %}
        {% set banner_section = webpage.firstWebsection('banner')|default(null) %}
        {% set hasBanner = banner_section.active|default(false) %}
        {% block banner_section %}
            {% if hasBanner %}
            {% include banner_section.twigfile with {websection: banner_section} %}
            {% endif %}
        {% endblock %}
        <div class="main-container {% block main_container_class %}{% endblock %}" {% block main_container_attrs %}{% endblock %}>
            {% block main_container %}
                {# main content here #}
                {% block webpage_content %}
                {% endblock %}
                {% block sections_container %}
                {% for websection in webpage.websections('section', true)|default([]) %}
                    {% include websection.twigfile %}
                {% endfor %}
                {% endblock %}
            {% endblock %}
			{% block addons %}
			{% endblock %}
            {% block footer_section %}
            {% set footer = webpage.firstWebsection('footer')|default(null) %}
            {% if footer is not null and footer.active %}
                {% include footer.twigfile with {websection: footer} %}
            {% endif %}
            {% endblock %}
        </div>
		{% block after_container %}
			{# commands, modals, etc. content here #}
		{% endblock %}
	</body>
	{% endblock %}
</html>