{# templates/webpage/models/images_square.html.twig #}
{# description : Miniatures carrées et agrandissement dans une popup #}
{% extends "@AequationLabo/base_web.html.twig" %}

{% block main_container %}

    {% block before_slider %}
    {% endblock %}

    {% block the_slider %}
        {% if webpage is defined %}

        <section class="min-h-[50vh] mb-0 pb-0">

            <div class="section-container-full">

                {% block slider_texts %}
                    {% if webpage.slider.content %}
                        <section class="pt-1">
                            {# {% if webpage.slider.title %}
                            <h3 class="mb-3">{{ webpage.slider.title|raw }}</h3>
                            {% endif %} #}
                            {% if webpage.slider.content %}
                            {{ webpage.slider.content|raw }}
                            {% endif %}
                        </section>
                    {% endif %}
                {% endblock %}

                {% set slides = webpage.slider.slides(true) %}
                {% set nbslides = slides | length %}
                {% if nbslides > 1 %}
                    <twig:ImagesSquareSlider :slider="webpage.slider" />
                {% elseif nbslides == 1 %}
                    {% set slide = slides|first %}
                    <img src="{{ vich_uploader_asset(slide)|imagine_filter(slide.imagefilter) }}" alt="{{ slide.slug|default(slide.name) }}" class="img-fluid mx-auto rounded-md border border-white">
                {% else %}
                    {# <div class="alert alert-info">Aucune image dans le diaporama</div> #}
                {% endif %}

            </div>

        </section>

        {% endif %}
    {% endblock %}

    {% block after_slider %}
    {% endblock %}

{% endblock %}
